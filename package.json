{
  "name": "@basitalisandhu/claude-perm-sim",
  "version": "0.1.0",
  "description": "Claude Code permission rule simulator: load the merged settings, see which rule decides any tool call, and find where the rules are more permissive than they look.",
  "license": "MIT",
  "author": "Muhammad Basit Ali",
  "homepage": "https://github.com/basitalisandhu/claude-perm-sim#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basitalisandhu/claude-perm-sim.git"
  },
  "bugs": {
    "url": "https://github.com/basitalisandhu/claude-perm-sim/issues"
  },
  "keywords": [
    "claude-code",
    "permissions",
    "permission-rules",
    "simulator",
    "least-privilege",
    "security",
    "cli",
    "agent-security",
    "sarif"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "claude-perm-sim": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build && vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
